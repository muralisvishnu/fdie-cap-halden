# Kyverno 3.3.x cleanup hooks execute scripts with /bin/bash.
# The upstream Kubernetes kubectl image is intentionally minimal and has no shell.
FROM registry.k8s.io/kubectl:v1.30.2 AS kubectl

FROM alpine:3.20
RUN apk add --no-cache bash ca-certificates
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl

USER 1001
ENTRYPOINT ["/usr/local/bin/kubectl"]
